From 194d2d8c72f6d17fb8b7abb72b11b6e67f4526da Mon Sep 17 00:00:00 2001
From: Heiko Schocher <hs@nabladev.com>
Date: Fri, 25 Sep 2026 11:30:13 +0200
Subject: [PATCH 25/25] linux: add interactive_plain_prompt to ash and bash

interactive() gives the inner shell a colored prompt with the current
directory, written with bash escapes. The ash of an old busybox (seen
with 1.7.1) does not expand them and prints

  \[\033[36m\]name: \[\033[32m\]\w\[\033[0m\]>

as it is. Add a class attribute interactive_plain_prompt, False by
default, which switches to a plain "<name>> " prompt. It still matches
the pattern interactive() waits for, so nothing else changes.

Signed-off-by: Heiko Schocher <hs@nabladev.com>
---
 tbot/machine/linux/ash.py  | 19 ++++++++++++++++---
 tbot/machine/linux/bash.py | 19 ++++++++++++++++---
 2 files changed, 32 insertions(+), 6 deletions(-)

diff --git a/tbot/machine/linux/ash.py b/tbot/machine/linux/ash.py
index 1828005..328188a 100644
--- a/tbot/machine/linux/ash.py
+++ b/tbot/machine/linux/ash.py
@@ -34,6 +34,16 @@ Self = typing.TypeVar("Self", bound="Ash")
 class Ash(linux_shell.LinuxShell):
     """Ash/Dash shell."""
 
+    interactive_plain_prompt: bool = False
+    """
+    Use a plain prompt in :py:meth:`interactive`.
+
+    By default the interactive shell gets a colored prompt which also shows
+    the current directory.  Some shells print these escape sequences
+    literally, for example the ash of old busybox versions.  Set this to
+    ``True`` to get a plain ``<name>> `` prompt instead.
+    """
+
     @contextlib.contextmanager
     def _init_shell(self) -> typing.Iterator:
         try:
@@ -258,9 +268,12 @@ class Ash(linux_shell.LinuxShell):
 
         # Inner shell which will be used by the user
         self.ch.sendline("ash")
-        prompt = self.escape(
-            f"\\[\\033[36m\\]{self.name}: \\[\\033[32m\\]\\w\\[\\033[0m\\]> "
-        )
+        if self.interactive_plain_prompt:
+            prompt = self.escape(f"{self.name}> ")
+        else:
+            prompt = self.escape(
+                f"\\[\\033[36m\\]{self.name}: \\[\\033[32m\\]\\w\\[\\033[0m\\]> "
+            )
         self.ch.sendline(f"PS1={prompt}")
 
         self.ch.read_until_prompt(prompt=re.compile(b"> (\x1B\\[.{0,10})?"))
diff --git a/tbot/machine/linux/bash.py b/tbot/machine/linux/bash.py
index 1801ca6..8f8fe34 100644
--- a/tbot/machine/linux/bash.py
+++ b/tbot/machine/linux/bash.py
@@ -33,6 +33,16 @@ Self = typing.TypeVar("Self", bound="Bash")
 class Bash(linux_shell.LinuxShell):
     """Bourne-again shell."""
 
+    interactive_plain_prompt: bool = False
+    """
+    Use a plain prompt in :py:meth:`interactive`.
+
+    By default the interactive shell gets a colored prompt which also shows
+    the current directory.  Some shells print these escape sequences
+    literally, for example the ash of old busybox versions.  Set this to
+    ``True`` to get a plain ``<name>> `` prompt instead.
+    """
+
     @contextlib.contextmanager
     def _init_shell(self) -> typing.Iterator:
         try:
@@ -264,9 +274,12 @@ class Bash(linux_shell.LinuxShell):
         # Inner shell which will be used by the user
         self.ch.sendline("bash --norc --noprofile")
         self.ch.sendline("set -o emacs")
-        prompt = self.escape(
-            f"\\[\\033[36m\\]{self.name}: \\[\\033[32m\\]\\w\\[\\033[0m\\]> "
-        )
+        if self.interactive_plain_prompt:
+            prompt = self.escape(f"{self.name}> ")
+        else:
+            prompt = self.escape(
+                f"\\[\\033[36m\\]{self.name}: \\[\\033[32m\\]\\w\\[\\033[0m\\]> "
+            )
         self.ch.sendline(f"PS1={prompt}")
 
         self.ch.read_until_prompt(prompt=re.compile(b"> (\x1B\\[.{0,10})?"))
