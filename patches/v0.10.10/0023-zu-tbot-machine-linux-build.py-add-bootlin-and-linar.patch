From 447e8d9549d0a3c4cb53131ddea8db4e31b8fc00 Mon Sep 17 00:00:00 2001
From: Heiko Schocher <hs@nabladev.com>
Date: Mon, 10 Aug 2026 13:54:12 +0200
Subject: [PATCH 23/23] zu tbot/machine/linux/build.py: add bootlin and linaro
 toolchains

Signed-off-by: Heiko Schocher <hs@nabladev.com>
---
 tbot/machine/linux/build.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tbot/machine/linux/build.py b/tbot/machine/linux/build.py
index 5a7a842..6886e8a 100644
--- a/tbot/machine/linux/build.py
+++ b/tbot/machine/linux/build.py
@@ -232,7 +232,7 @@ class EnvSetLinaroToolchain(Toolchain):
 
     """
 
-    def enable(self, host: H) -> None:  # noqa: D102
+    def enable(self, host: "Builder") -> None:  # noqa: D102
         td = host.workdir / "toolchain"
         if not td.exists():
             host.exec0("mkdir", "-p", td)
@@ -323,7 +323,7 @@ class EnvSetBootlinToolchain(Toolchain):
             }
     """
 
-    def enable(self, host: H) -> None:  # noqa: D102
+    def enable(self, host: "Builder") -> None:  # noqa: D102
         td = host.workdir / "toolchain"
         if not td.exists():
             host.exec0("mkdir", "-p", td)
-- 
