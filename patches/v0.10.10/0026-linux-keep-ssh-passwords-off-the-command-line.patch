From 598170033c1fc11b5aaa3ad6444858bf9fed8d44 Mon Sep 17 00:00:00 2001
From: Heiko Schocher <hs@nabladev.com>
Date: Fri, 25 Sep 2026 12:04:57 +0200
Subject: [PATCH 26/26] linux: keep ssh passwords off the command line

SSHConnector and the scp copy pass a PasswordAuthenticator's password
with "sshpass -p <password>". That puts it on the command line, where
it shows up in tbot's command log and in the process list of the host.

Add PasswordAuthenticator.export_sshpass(), which sets SSHPASS in the
host's shell, and call "sshpass -e" instead. The line is sent with the
channel trace paused, so the password does not appear at CHANNEL
verbosity either. SSHConnector sets it in the cloned shell that turns
into the ssh session; the scp copy sets it in a subshell, so it does
not outlive the copy.

Add a selftest that checks a password with blanks, quotes and a $ ends
up in SSHPASS unchanged, and that the log verbosity is restored.

Signed-off-by: Heiko Schocher <hs@nabladev.com>
---
 selftest/tests/test_shell.py  | 10 ++++++++++
 tbot/machine/connector/ssh.py |  3 ++-
 tbot/machine/linux/auth.py    | 19 +++++++++++++++++++
 tbot/machine/linux/copy.py    | 20 +++++++++++++-------
 4 files changed, 44 insertions(+), 8 deletions(-)

diff --git a/selftest/tests/test_shell.py b/selftest/tests/test_shell.py
index c8ee2c1..f1fd445 100644
--- a/selftest/tests/test_shell.py
+++ b/selftest/tests/test_shell.py
@@ -301,3 +301,13 @@ def test_unclean_shell(tbot_context: tbot.Context) -> None:
             with pytest.raises(tbot.error.UncleanShellError):
                 with lnx.subshell():
                     lnx.exec0("uname")
+
+
+def test_export_sshpass(any_linux_shell: AnyLinuxShell) -> None:
+    with any_linux_shell() as linux_shell:
+        password = "pass word 'quoted' \"too\" $HOME"
+        verbosity = tbot.log.VERBOSITY
+        with linux_shell.subshell():
+            linux.auth.PasswordAuthenticator(password).export_sshpass(linux_shell)
+            assert linux_shell.env("SSHPASS") == password
+        assert tbot.log.VERBOSITY == verbosity
diff --git a/tbot/machine/connector/ssh.py b/tbot/machine/connector/ssh.py
index a7dcb8f..bdb2d7a 100644
--- a/tbot/machine/connector/ssh.py
+++ b/tbot/machine/connector/ssh.py
@@ -193,7 +193,8 @@ class SSHConnector(connector.Connector):
                     authenticator.get_key_for_host(h),
                 ]
             elif isinstance(authenticator, auth.PasswordAuthenticator):
-                cmd = ["sshpass", "-p", authenticator.password, "ssh"]
+                authenticator.export_sshpass(h)
+                cmd = ["sshpass", "-e", "ssh"]
             else:
                 if typing.TYPE_CHECKING:
                     authenticator._undefined_marker
diff --git a/tbot/machine/linux/auth.py b/tbot/machine/linux/auth.py
index dcf8c0c..6ccd73b 100644
--- a/tbot/machine/linux/auth.py
+++ b/tbot/machine/linux/auth.py
@@ -16,6 +16,7 @@
 
 import typing
 import pathlib
+import tbot
 from .. import linux
 
 
@@ -46,6 +47,24 @@ class PasswordAuthenticator(AuthenticatorBase):
     def __init__(self, password: str) -> None:
         self.password = password
 
+    def export_sshpass(self, host: "linux.LinuxShell") -> None:
+        """
+        Put the password into ``SSHPASS`` in the shell of ``host``, for
+        ``sshpass -e``.
+
+        Unlike ``sshpass -p <password>``, this keeps the password off the
+        command line, so it shows up neither in tbot's command log nor in
+        the process list.  The line is sent with the channel trace paused,
+        so it does not show up at ``CHANNEL`` verbosity either.
+        """
+        old = tbot.log.VERBOSITY
+        tbot.log.VERBOSITY = min(old, tbot.log.Verbosity.STDOUT)
+        try:
+            host.ch.sendline("export SSHPASS=" + host.escape(self.password))
+            host.ch.read_until_prompt()
+        finally:
+            tbot.log.VERBOSITY = old
+
 
 class PrivateKeyAuthenticator(AuthenticatorBase):
     """
diff --git a/tbot/machine/linux/copy.py b/tbot/machine/linux/copy.py
index 7ad7902..dc759bd 100644
--- a/tbot/machine/linux/copy.py
+++ b/tbot/machine/linux/copy.py
@@ -55,16 +55,24 @@ def _scp_copy(
             authenticator.get_key_for_host(local_host),
         ]
     elif isinstance(authenticator, auth.PasswordAuthenticator):
-        scp_command = ["sshpass", "-p", authenticator.password] + scp_command
+        scp_command = ["sshpass", "-e"] + scp_command
     else:
         if typing.TYPE_CHECKING:
             authenticator._undefined_marker
         raise ValueError("Unknown authenticator {authenticator!r}")
 
+    def run_scp(*args: typing.Any) -> None:
+        if isinstance(authenticator, auth.PasswordAuthenticator):
+            # SSHPASS only lives in this subshell
+            with local_host.subshell():
+                authenticator.export_sshpass(local_host)
+                local_host.exec0(*scp_command, *args)
+        else:
+            local_host.exec0(*scp_command, *args)
+
     if remote_copy:
         rh = remote_path.host
-        local_host.exec0(
-            *scp_command,
+        run_scp(
             f"{local_host.username}@{local_host.hostname}:{local_path._local_str()}",
             f"{rh.username}@{rh.hostname}:{remote_path._local_str()}",
         )
@@ -72,14 +80,12 @@ def _scp_copy(
         return
 
     if copy_to_remote:
-        local_host.exec0(
-            *scp_command,
+        run_scp(
             local_path,
             f"{username}@{hostname}:{remote_path.at_host(remote_path.host)}",
         )
     else:
-        local_host.exec0(
-            *scp_command,
+        run_scp(
             f"{username}@{hostname}:{remote_path.at_host(remote_path.host)}",
             local_path,
         )
